# Senjuku Nihongo — Environment Configuration Example
# Copy this file to .env and fill in your credentials. NEVER commit .env to version control.

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
BASE_URL=http://localhost:3000
# Persistent SQLite path (use ../../data/senjuku.db on /deploys/<hash>/ hosting panels so DB survives redeploys)
DB_PATH=../../data/senjuku.db

# GOOGLE_TTS_API_KEY=yourkey

# GEMINI_API_KEY=yourkey
# GEMINI_ADVISOR_MODEL=gemini-3.1-flash-lite

# Native Tokyo Voice Models (Google Cloud Neural2):
# ja-JP-Neural2-C: Suara Pria Asli Jepang (Tokyo Accent)
# ja-JP-Neural2-B: Suara Wanita Asli Jepang (Tokyo Accent)
GOOGLE_TTS_MALE_VOICE=ja-JP-Chirp3-HD-Umbriel
GOOGLE_TTS_FEMALE_VOICE=ja-JP-Neural2-B

# AI Advisor (Gemini 3.5 Flash-Lite)
# If GEMINI_API_KEY is left empty, AI Advisor gracefully falls back to deterministic rule-based analytics.
GEMINI_API_KEY=
GEMINI_ADVISOR_MODEL=gemini-3.5-flash-lite
GEMINI_ADVISOR_THINKING_LEVEL=low
GEMINI_ADVISOR_TIMEOUT_MS=12000

# Default Admin Auto-Seed (Fresh Installation Bootstrap)
# Automatically creates an active Admin (Sensei) account if no admin exists in SQLite.
# ADMIN_DEFAULT_EMAIL=admin@senjuku.local
# ADMIN_DEFAULT_NICKNAME=SenseiAdmin
# ADMIN_DEFAULT_PASSWORD=AdminSenjuku123!
# ADMIN_FORCE_CHANGE_PASSWORD=1
# DISABLE_ADMIN_AUTO_SEED=0

# Optional: Email / SMTP (leave SKIP_SMTP=1 for local development)
# Supports Port 465 (Implicit SSL/TLS) and Port 587 / 2525 (STARTTLS)
SKIP_SMTP=1
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# Bare email address only (do NOT use "Name <email>" format); set display name via SMTP_FROM_NAME
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME=Senjuku Nihongo
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# Optional: Native Japanese Neural TTS Providers
# GOOGLE_TTS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# VOICEVOX_URL=
